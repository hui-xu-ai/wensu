  "plugins": [
    {
      "name": "@hui-xu-ai/dsh-wensu",
      "title": {
        "en": "Wensu · CNKI and Web of Science search",
        "zh": "文溯 · 知网与 Web of Science 检索"
      },
      "description": {
        "en": "Read-only bibliographic search over CNKI and Web of Science, exposed to the agent as MCP tools (search, detail, export, status). The WoS channel carries journal impact factors and accepts Web of Science expressions; CNKI takes expert-form expressions such as SU='...' / TI='...'. Filtering and sorting run locally without extra requests. No full-text download. Needs Windows, Python 3.11+, the `wensu` command on PATH, plus the companion browser extension and native host.",
        "zh": "以 MCP 工具接入 agent 的只读文献题录检索，覆盖知网与 Web of Science 双渠道（search / detail / export / status）。WoS 记录自带期刊影响因子、接受 Web of Science 检索式；知网走专业检索、接受 SU='…' / TI='…' 这类检索式。筛选与排序在本地完成，零额外请求。不下载全文。需要 Windows、Python 3.11+、PATH 中的 wensu 命令，并另行配置浏览器扩展与原生宿主。"
      },
      "icon": "icons/wensu.svg",
      "author": "hui-xu-ai",
      "homepage": "https://github.com/hui-xu-ai/wensu",
