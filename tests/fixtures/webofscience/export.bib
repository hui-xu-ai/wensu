Book-Group-Author = {IEEE},
Title = {NOVEL MINIATURIZED BI-STABLE SELF-SENSING SOFT ACTUATOR BASED ON
   CNT-DISPERSED IONOGEL},
Booktitle = {2024 IEEE 37TH INTERNATIONAL CONFERENCE ON MICRO ELECTRO MECHANICAL
