{
  "manifest_version": 3,
  "name": "wensu bridge",
  "version": "0.12.34",
  "key": "",
  "description": "Read-only bibliographic retrieval bridge. Nine generic verbs, no site logic.",
  "permissions": ["nativeMessaging", "tabs"],
  "host_permissions": [
    "https://*.cnki.net/*",
    "https://webofscience.clarivate.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.cnki.net/*"],
      "js": ["content/actions.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://webofscience.clarivate.cn/*"],
      "js": ["content/actions.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://webofscience.clarivate.cn/*"],
      "js": ["content/capture.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
