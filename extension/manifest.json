{
  "manifest_version": 3,
  "name": "wensu bridge",
  "version": "0.14.14",
  "key": "",
  "description": "Read-only bibliographic retrieval bridge. Ten generic verbs, no site logic.",
  "permissions": ["nativeMessaging", "storage", "tabs", "downloads", "pageCapture", "debugger"],
  "host_permissions": [
    "https://*.cnki.net/*",
    "https://webofscience.com/*",
    "https://*.webofscience.com/*",
    "https://webofscience.clarivate.cn/*"
  ],
  "background": {
    "service_worker": "background-0.14.14.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://sciencedirect.com/*",
        "https://*.sciencedirect.com/*",
        "https://link.springer.com/*",
        "https://*.link.springer.com/*",
        "https://nature.com/*",
        "https://*.nature.com/*",
        "https://onlinelibrary.wiley.com/*",
        "https://*.onlinelibrary.wiley.com/*",
        "https://pubs.acs.org/*",
        "https://*.pubs.acs.org/*",
        "https://pubs.rsc.org/*",
        "https://*.pubs.rsc.org/*",
        "https://tandfonline.com/*",
        "https://*.tandfonline.com/*",
        "https://journals.sagepub.com/*",
        "https://*.journals.sagepub.com/*",
        "https://mdpi.com/*",
        "https://*.mdpi.com/*",
        "https://frontiersin.org/*",
        "https://*.frontiersin.org/*",
        "https://journals.plos.org/*",
        "https://*.journals.plos.org/*",
        "https://arxiv.org/*",
        "https://*.arxiv.org/*",
        "https://ieeexplore.ieee.org/*",
        "https://*.ieeexplore.ieee.org/*",
        "https://dl.acm.org/*",
        "https://*.dl.acm.org/*",
        "https://science.org/*",
        "https://*.science.org/*",
        "https://pnas.org/*",
        "https://*.pnas.org/*",
        "https://bmj.com/*",
        "https://*.bmj.com/*",
        "https://nejm.org/*",
        "https://*.nejm.org/*",
        "https://jamanetwork.com/*",
        "https://*.jamanetwork.com/*",
        "https://cambridge.org/*",
        "https://*.cambridge.org/*",
        "https://academic.oup.com/*",
        "https://*.academic.oup.com/*",
        "https://iopscience.iop.org/*",
        "https://*.iopscience.iop.org/*",
        "https://journals.aps.org/*",
        "https://*.journals.aps.org/*",
        "https://pubs.aip.org/*",
        "https://*.pubs.aip.org/*",
        "https://karger.com/*",
        "https://*.karger.com/*"
      ],
      "js": ["content/readiness.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://*.cnki.net/*"],
      "js": ["content/actions.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://webofscience.com/*",
        "https://*.webofscience.com/*"
      ],
      "js": ["content/actions.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["https://webofscience.clarivate.cn/*"],
      "js": ["content/actions.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://webofscience.com/*",
        "https://*.webofscience.com/*",
        "https://webofscience.clarivate.cn/*"
      ],
      "js": ["content/capture.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
